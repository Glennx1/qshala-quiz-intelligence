# QShala Quiz Intelligence Platform Environment Configuration

PROJECT_NAME="QShala Quiz Intelligence Platform"

# Database Configuration:
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/qshala"
# For zero-configuration local development (automatic fallback):
DATABASE_URL="sqlite:///./backend/qshala.db"

# Data safety: the app refuses to boot on a non-persistent SQLite database by default (True).
# That's correct for every deployed environment (Render, Railway, etc) -- it's what stops a missing
# or flaky DATABASE_URL from silently losing the question vault on the next restart. Running the
# local SQLite fallback above requires explicitly opting out here:
REQUIRE_POSTGRES="False"

# AI Provider Configuration:
# Choose 'gemini', 'openai', or 'local'
LLM_PROVIDER="local"
EMBEDDING_PROVIDER="local"

# External API Keys (optional; if omitted, system runs on high-fidelity deterministic local engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Gemini model used for tagging/generation. Code default (if this is blank/unset) is
# gemini-3.5-flash-lite -- set it explicitly to keep it visible here too.
# Override here if Google renames/retires it later -- no code change needed.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Hybrid tagging thresholds (cost control): the free rule-based tagger always runs first.
# A question only gets escalated to the Gemini API when its top keyword-match score is
# below TAGGING_CONFIDENCE_THRESHOLD, or when the runner-up topic is within
# TAGGING_AMBIGUITY_RATIO of the top score (i.e. it's a genuinely ambiguous call).
# Raise the threshold / lower the ratio to send MORE questions to Gemini (more accurate,
# more cost); lower/raise them to send fewer (cheaper, relies more on keyword matching).
TAGGING_CONFIDENCE_THRESHOLD=4.0
TAGGING_AMBIGUITY_RATIO=0.65

# Early-volume override: "true" sends EVERY question to Gemini, ignoring the
# confidence gate above entirely. Use this while ingestion volume is low (first
# few hundred questions) and accuracy matters more than API cost. Once you've
# accumulated enough Gemini-tagged questions to train your own local classifier
# (e.g. after a SharePoint bulk sync), set this to "false" to re-enable the
# cost-saving hybrid gate.
FORCE_AI_TAGGING="true"

# Vector & Validation Settings
EMBEDDING_DIM=768
DUPLICATE_SIMILARITY_THRESHOLD=0.85
MIN_GROUNDING_SCORE=0.70

# Cloudflare R2 Object Storage (optional). Media (slide images, audio, video) is
# stored locally on disk when these are left blank -- exactly like today. Fill
# these in to upload media to R2 instead (cheap storage, zero egress fees).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL=""  # e.g. https://pub-xxxxxxxx.r2.dev or your own custom domain

# Optional shared-secret API gate (off by default -- leave blank to keep today's open behavior).
# Set this on the deployed backend, and set the matching NEXT_PUBLIC_API_KEY in the frontend's env
# (see frontend/.env.example), to stop anonymous visitors from uploading/deleting/burning quota.
# API_KEY_SECRET=""

# Comma-separated list of allowed frontend origins. Required once deployed -- unset/blank falls
# back to localhost-only, NOT "*", so a deployed frontend can't reach the API until this is set.
# Example: CORS_ORIGINS="https://qshala.vercel.app,https://qshala-git-main-yourteam.vercel.app"
# CORS_ORIGINS=""

# Serial upload queue (opt-in; direct per-upload processing is the default and recommended path).
UPLOAD_QUEUE_ENABLED="False"

# QShala-domain tagger model override. Blank/unset falls back to gemini-3.5-flash-lite.
# QSHALA_TAGGER_MODEL=""

# Memory tuning for small hosts (512MB-1GB containers). Not read by the app itself -- these are
# process-level env vars read by the Python/glibc runtime -- but worth setting on whatever host
# replaces Render/Railway:
#   MALLOC_ARENA_MAX=2       caps glibc's per-thread memory arenas; the single most effective
#                            memory setting found for the ingestion pipeline on a small container.
#   VISION_CONCURRENCY=1     limits concurrent Gemini vision calls during deck ingestion.
# Also run with a single web worker (no --workers 2+): the upload queue's advisory lock and
# in-process state assume one process.

# Gemini request concurrency for batch question tagging (separate from VISION_CONCURRENCY above,
# which is for image/vision calls). Default 8 assumes a paid-tier Gemini key with billing linked --
# drop this back down (e.g. 2) if running on the Gemini free tier, to avoid 429s.
# QSHALA_TAG_CHUNK_CONCURRENCY=8

# Soft memory-safety margin for ingestion, not a hard cap: crossing this logs one warning to the
# upload page's activity log so a deck approaching the container's real memory limit is visible
# before it ever gets there. Never aborts or throttles ingestion. Default 1792 MB = 1.75 GB,
# leaving ~256 MB of headroom below the 2048 MB the Cloud Run worker is given today -- raise it
# if the worker's memory allocation changes.
# MEMORY_WARN_THRESHOLD_MB=1792

# Where deck ingestion actually runs. "in_process" (default) is today's behavior -- zero change
# unless you set this. "cloud_run_job" offloads ingestion to a separate Cloud Run Job execution
# (backend/worker.py) per upload, so a heavy deck can't starve the API service's own request
# handling or exhaust its memory. Requires the three GCP_* vars below to also be set, and the API
# service's runtime service account needs run.jobs.run on the job (see deployment docs for the
# gcloud setup steps). Misconfigured (mode set but vars missing) fails the upload loudly rather
# than silently leaving it stuck at PENDING.
# INGESTION_MODE="cloud_run_job"
# GCP_PROJECT_ID=""
# GCP_REGION="asia-south1"
# INGESTION_JOB_NAME="qshala-ingestion-worker"
