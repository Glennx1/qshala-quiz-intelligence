# QShala Quiz Intelligence Platform Environment Configuration

PROJECT_NAME="QShala Quiz Intelligence Platform"

# Database Configuration:
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/qshala"
# For zero-configuration local development (automatic fallback):
DATABASE_URL="sqlite:///./backend/qshala.db"

# AI Provider Configuration:
# Choose 'gemini', 'openai', or 'local'
LLM_PROVIDER="local"
EMBEDDING_PROVIDER="local"

# External API Keys (optional; if omitted, system runs on high-fidelity deterministic local engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Gemini model used for tagging/generation. GA as of Oct 2026, no shutdown date announced.
# Override here if Google renames/retires it later -- no code change needed.
GEMINI_MODEL="gemini-2.5-flash"

# Hybrid tagging thresholds (cost control): the free rule-based tagger always runs first.
# A question only gets escalated to the Gemini API when its top keyword-match score is
# below TAGGING_CONFIDENCE_THRESHOLD, or when the runner-up topic is within
# TAGGING_AMBIGUITY_RATIO of the top score (i.e. it's a genuinely ambiguous call).
# Raise the threshold / lower the ratio to send MORE questions to Gemini (more accurate,
# more cost); lower/raise them to send fewer (cheaper, relies more on keyword matching).
TAGGING_CONFIDENCE_THRESHOLD=4.0
TAGGING_AMBIGUITY_RATIO=0.65

# Early-volume override: "true" sends EVERY question to Gemini, ignoring the
# confidence gate above entirely. Use this while ingestion volume is low (first
# few hundred questions) and accuracy matters more than API cost. Once you've
# accumulated enough Gemini-tagged questions to train your own local classifier
# (e.g. after a SharePoint bulk sync), set this to "false" to re-enable the
# cost-saving hybrid gate.
FORCE_AI_TAGGING="true"

# Vector & Validation Settings
EMBEDDING_DIM=768
DUPLICATE_SIMILARITY_THRESHOLD=0.85
MIN_GROUNDING_SCORE=0.70

# Cloudflare R2 Object Storage (optional). Media (slide images, audio, video) is
# stored locally on disk when these are left blank -- exactly like today. Fill
# these in to upload media to R2 instead (cheap storage, zero egress fees).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL=""  # e.g. https://pub-xxxxxxxx.r2.dev or your own custom domain
