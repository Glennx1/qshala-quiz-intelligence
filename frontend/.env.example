# QShala frontend environment configuration

# Backend API base. If unset: falls back to /api/v1 in the browser (same-origin / proxy setups),
# or VERCEL_URL, or http://localhost:8000/api/v1 for local dev against a local backend.
# NEXT_PUBLIC_API_URL="https://your-backend-host.example.com/api/v1"

# Matches the backend's API_KEY_SECRET (see backend .env.example). Optional -- leave unset while
# API_KEY_SECRET is unset on the backend. Once the backend starts requiring the header, every
# request from this app needs the same value here or it will get 401s.
# NEXT_PUBLIC_API_KEY=""

# Sentry error tracking (optional, off by default -- unset means Sentry.init is never called).
# Same DSN value in both -- NEXT_PUBLIC_SENTRY_DSN is read client-side (browser bundle),
# SENTRY_DSN is read server/edge-side (instrumentation.ts). Both are needed for full coverage.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# Only needed for readable stack traces in the Sentry UI (source map upload at build time).
# Leave unset to skip that step -- error tracking still works, traces just show minified code.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
